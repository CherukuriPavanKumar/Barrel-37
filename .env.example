# --- Frontend (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Booking notifications (server-side only, set in Vercel > Project > Settings > Environment Variables) ---
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# SMSAPI.pl OAuth token (SMSAPI panel > API tokens), needs the "sms" scope
SMSAPI_TOKEN=

# Optional overrides
# NOTIFY_EMAIL=joinusbarrel37@gmail.com
# NOTIFY_PHONE=48500458966
# Sender address; must be on a domain verified in Resend (default: onboarding@resend.dev)
# RESEND_FROM=Barrel 37 Bookings <bookings@yourdomain.pl>
# Sender name registered in the SMSAPI panel (default: account default sender)
# SMSAPI_FROM=Barrel37
